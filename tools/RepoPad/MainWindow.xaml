<Window x:Class="RepoPad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RepoPad"
        Title="RepoPad"
        Width="1040" Height="660"
        MinWidth="920" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="#BDB8AE"
        FontFamily="Segoe UI Variable Text"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <local:HexBrushConverter x:Key="HexBrushConverter"/>

        <Style x:Key="UtilityButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="#E8E2D7"/>
            <Setter Property="Background" Value="#302F2A"/>
            <Setter Property="BorderBrush" Value="#11110F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Shadow"
                                    Margin="0,3,0,0"
                                    CornerRadius="5"
                                    Background="#11110F"/>
                            <Border x:Name="Face"
                                    Margin="0,0,0,3"
                                    CornerRadius="5"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#403E37"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="#E8D08C"/>
                                <Setter TargetName="Face" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Margin" Value="0,3,0,0"/>
                                <Setter TargetName="Shadow" Property="Margin" Value="0,1,0,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Face" Property="Opacity" Value="0.42"/>
                                <Setter TargetName="Shadow" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PadKeyStyle" TargetType="Button">
            <Setter Property="Width" Value="318"/>
            <Setter Property="Height" Value="236"/>
            <Setter Property="Margin" Value="7"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#D85E2B"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Margin="4">
                            <Border x:Name="Base"
                                    Margin="0,13,0,0"
                                    CornerRadius="15"
                                    Background="#191815"/>
                            <Border x:Name="Skirt"
                                    Margin="0,6,0,4"
                                    CornerRadius="15"
                                    Background="{TemplateBinding Background}"
                                    Opacity="0.58"
                                    BorderBrush="#191815"
                                    BorderThickness="2"/>
                            <Border x:Name="Face"
                                    Margin="0,0,0,10"
                                    CornerRadius="15"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="#191815"
                                    BorderThickness="2"
                                    Padding="18">
                                <Grid>
                                    <ContentPresenter HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch"/>
                                    <Border x:Name="HoverWash"
                                            CornerRadius="11"
                                            Background="#FFFFFF"
                                            Opacity="0"
                                            IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverWash" Property="Opacity" Value="0.08"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="#FFF4E7"/>
                                <Setter TargetName="Face" Property="BorderThickness" Value="3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Margin" Value="0,8,0,2"/>
                                <Setter TargetName="Skirt" Property="Margin" Value="0,9,0,1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Face" Property="Opacity" Value="0.5"/>
                                <Setter TargetName="Skirt" Property="Opacity" Value="0.3"/>
                                <Setter TargetName="Base" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Border CornerRadius="18"
                Background="#E7E1D6"
                BorderBrush="#24231F"
                BorderThickness="2"
                Padding="18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" Direction="270" ShadowDepth="8" Opacity="0.22"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="42" Height="42"
                            CornerRadius="8"
                            Background="#23221E"
                            BorderBrush="#0F0F0D"
                            BorderThickness="1">
                        <TextBlock Text="RP"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Cascadia Mono, Consolas"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#F0E9DD"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="REPOPAD / LOCAL APPLY"
                                   FontFamily="Cascadia Mono, Consolas"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#5B564E"/>
                        <TextBlock Text="One key. One checked-in script."
                                   Margin="0,2,0,0"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#1C1B18"/>
                    </StackPanel>

                    <Border Grid.Column="2"
                            CornerRadius="8"
                            Background="#D7D1C5"
                            BorderBrush="#AAA396"
                            BorderThickness="1"
                            Padding="11,7">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusLed"
                                     Width="9" Height="9"
                                     Fill="#77736B"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText"
                                       Text="READY"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#34312C"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            CornerRadius="13"
                            Background="#D0CABF"
                            BorderBrush="#A59E91"
                            BorderThickness="1"
                            Padding="12">
                        <Grid>
                            <Ellipse Width="6" Height="6" Fill="#766F65" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <Ellipse Width="6" Height="6" Fill="#766F65" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                            <Ellipse Width="6" Height="6" Fill="#766F65" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                            <Ellipse Width="6" Height="6" Fill="#766F65" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>

                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid>
                                    <TextBlock Text="REPOSITORIES"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="#5F5A51"/>
                                    <TextBlock x:Name="RepoCountText"
                                               Text="00"
                                               HorizontalAlignment="Right"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="9"
                                               Foreground="#766F65"/>
                                </Grid>

                                <Border Grid.Row="2"
                                        CornerRadius="10"
                                        Background="#C3BDB2"
                                        BorderBrush="#AEA79A"
                                        BorderThickness="1"
                                        Padding="4">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="PadItems"
                                                      ItemsSource="{Binding Repositories}"
                                                      HorizontalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel HorizontalAlignment="Center"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource PadKeyStyle}"
                                                            Background="{Binding Accent, Converter={StaticResource HexBrushConverter}}"
                                                            Click="RepoButton_Click"
                                                            Tag="{Binding}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="*"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <Grid>
                                                                <Border CornerRadius="4"
                                                                        Background="#2B211C"
                                                                        Padding="7,3"
                                                                        HorizontalAlignment="Left">
                                                                    <TextBlock Text="{Binding Slot}"
                                                                               FontFamily="Cascadia Mono, Consolas"
                                                                               FontSize="9"
                                                                               FontWeight="Bold"
                                                                               Foreground="#F7E9DC"/>
                                                                </Border>
                                                                <Ellipse Width="7" Height="7"
                                                                         Fill="#2A211C"
                                                                         HorizontalAlignment="Right"
                                                                         VerticalAlignment="Center"/>
                                                            </Grid>

                                                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}"
                                                                           HorizontalAlignment="Center"
                                                                           FontSize="13"
                                                                           FontWeight="Bold"
                                                                           Foreground="#30231E"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="APPLY"
                                                                           Margin="0,5,0,0"
                                                                           HorizontalAlignment="Center"
                                                                           FontSize="46"
                                                                           FontWeight="Black"
                                                                           Foreground="#FFF7EF"/>
                                                            </StackPanel>

                                                            <Grid Grid.Row="2">
                                                                <TextBlock Text="{Binding Subtitle}"
                                                                           FontSize="10"
                                                                           Foreground="#412D24"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBlock Text="PRESS"
                                                                           HorizontalAlignment="Right"
                                                                           FontFamily="Cascadia Mono, Consolas"
                                                                           FontSize="8"
                                                                           FontWeight="Bold"
                                                                           Foreground="#412D24"/>
                                                            </Grid>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            CornerRadius="13"
                            Background="#1B1A17"
                            BorderBrush="#0E0E0C"
                            BorderThickness="2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="1"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="1"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="14,11">
                                <TextBlock Text="COMMAND"
                                           FontFamily="Cascadia Mono, Consolas"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="#CFC8BC"/>
                                <TextBlock x:Name="CommandStateText"
                                           Text="STANDBY"
                                           HorizontalAlignment="Right"
                                           FontFamily="Cascadia Mono, Consolas"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="#78816F"/>
                            </Grid>

                            <Rectangle Grid.Row="1" Fill="#33312C"/>

                            <Border Grid.Row="2"
                                    Margin="13,11,13,9"
                                    CornerRadius="6"
                                    Background="#242720"
                                    BorderBrush="#383D32"
                                    BorderThickness="1"
                                    Padding="11,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="SelectedRepoName"
                                                   Text="NO REPOSITORY"
                                                   FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="#DDE7CF"/>
                                        <TextBlock x:Name="SelectedRepoPath"
                                                   Text="Select a repository key"
                                                   Margin="0,2,0,0"
                                                   FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="9"
                                                   Foreground="#89917F"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock x:Name="LastRunText"
                                               Grid.Column="1"
                                               Text="NO RUN"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="8"
                                               FontWeight="Bold"
                                               Foreground="#92998C"/>
                                </Grid>
                            </Border>

                            <TextBox x:Name="OutputBox"
                                     Grid.Row="3"
                                     Margin="13,2,13,10"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#D6DEC9"
                                     SelectionBrush="#D85E2B"
                                     FontFamily="Cascadia Mono, Consolas"
                                     FontSize="11"/>

                            <Rectangle Grid.Row="4" Fill="#33312C"/>

                            <Grid x:Name="UtilityActions" Grid.Row="5" Margin="13,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="135"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Style="{StaticResource UtilityButtonStyle}" Click="OpenApp_Click">OPEN APP</Button>
                                <Button Grid.Column="1" Style="{StaticResource UtilityButtonStyle}" Click="OpenFolder_Click">FOLDER</Button>
                                <Button Grid.Column="2" Style="{StaticResource UtilityButtonStyle}" Click="ClearLog_Click">CLEAR</Button>

                                <ProgressBar x:Name="RunProgress"
                                             Grid.Column="4"
                                             Height="5"
                                             VerticalAlignment="Center"
                                             IsIndeterminate="True"
                                             Visibility="Collapsed"
                                             Foreground="#D85E2B"
                                             Background="#302E29"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="4">
                    <TextBlock Text="ADMIN · REPOSITORY-OWNED APPLY SCRIPT"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="9"
                               Foreground="#655F56"/>
                    <TextBlock Text="RP-01"
                               HorizontalAlignment="Right"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="9"
                               Foreground="#7D766C"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
