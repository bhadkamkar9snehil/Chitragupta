<Window x:Class="RepoPad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RepoPad"
        Width="980" Height="640"
        MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#CFC9BC"
        FontFamily="Segoe UI Variable Text">
    <Window.Resources>
        <Style x:Key="PadKeyStyle" TargetType="Button">
            <Setter Property="Width" Value="300"/>
            <Setter Property="Height" Value="270"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Margin="5">
                            <Border x:Name="KeyShadow"
                                    Margin="0,10,0,0"
                                    CornerRadius="22"
                                    Background="#23221F"/>
                            <Border x:Name="KeyFace"
                                    CornerRadius="22"
                                    Background="#D85E2B"
                                    BorderBrush="#23221F"
                                    BorderThickness="2"
                                    Padding="20">
                                <ContentPresenter HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="KeyFace" Property="Background" Value="#E66B34"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="KeyFace" Property="Margin" Value="0,7,0,0"/>
                                <Setter TargetName="KeyShadow" Property="Margin" Value="0,5,0,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="KeyFace" Property="Opacity" Value="0.58"/>
                                <Setter TargetName="KeyShadow" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Border CornerRadius="28"
                Background="#E8E2D6"
                BorderBrush="#2A2925"
                BorderThickness="2"
                Padding="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" Direction="270" ShadowDepth="8" Opacity="0.24"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="2,0,2,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="REPO PAD / 01"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#57534A"
                                   CharacterSpacing="120"/>
                        <TextBlock Text="LOCAL APPLY CONTROLLER"
                                   Margin="0,5,0,0"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="#1F1E1B"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusLed" Width="11" Height="11" Fill="#77736B" Margin="0,0,9,0"/>
                        <TextBlock x:Name="StatusText"
                                   Text="READY"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#4D4A44"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            CornerRadius="20"
                            Background="#D8D2C6"
                            BorderBrush="#AAA396"
                            BorderThickness="1"
                            Padding="10">
                        <Grid>
                            <Ellipse Width="7" Height="7" Fill="#817B71" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4"/>
                            <Ellipse Width="7" Height="7" Fill="#817B71" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"/>
                            <Ellipse Width="7" Height="7" Fill="#817B71" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4"/>
                            <Ellipse Width="7" Height="7" Fill="#817B71" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4"/>

                            <ItemsControl x:Name="PadItems"
                                          ItemsSource="{Binding Repositories}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource PadKeyStyle}"
                                                Click="RepoButton_Click"
                                                Tag="{Binding}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid>
                                                    <TextBlock Text="KEY 01"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="#F8E6DB"
                                                               CharacterSpacing="120"/>
                                                    <Ellipse Width="8" Height="8"
                                                             Fill="#231F1C"
                                                             HorizontalAlignment="Right"/>
                                                </Grid>
                                                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               HorizontalAlignment="Center"
                                                               FontSize="15"
                                                               FontWeight="Bold"
                                                               Foreground="#2A201B"
                                                               CharacterSpacing="80"/>
                                                    <TextBlock Text="APPLY"
                                                               Margin="0,8,0,0"
                                                               HorizontalAlignment="Center"
                                                               FontSize="52"
                                                               FontWeight="Black"
                                                               Foreground="#FFF5EC"/>
                                                    <TextBlock Text="PULL · CHECK · BUILD · RESTART"
                                                               Margin="0,7,0,0"
                                                               HorizontalAlignment="Center"
                                                               FontFamily="Consolas"
                                                               FontSize="10"
                                                               Foreground="#F8E6DB"/>
                                                </StackPanel>
                                                <TextBlock Grid.Row="2"
                                                           Text="{Binding Subtitle}"
                                                           HorizontalAlignment="Center"
                                                           FontSize="12"
                                                           Foreground="#392922"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            CornerRadius="20"
                            Background="#1E1D1A"
                            BorderBrush="#2A2925"
                            BorderThickness="2"
                            Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Background="#292824" Margin="1" Height="44">
                                <TextBlock Text="COMMAND MONITOR"
                                           Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#C8C2B7"
                                           CharacterSpacing="100"/>
                                <TextBlock Text="ADMIN"
                                           Margin="0,0,16,0"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="#D8A84E"/>
                            </Grid>
                            <TextBox x:Name="OutputBox"
                                     Grid.Row="1"
                                     Margin="14"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#D9E7CF"
                                     SelectionBrush="#D85E2B"
                                     CaretBrush="#D9E7CF"
                                     FontFamily="Cascadia Mono, Consolas"
                                     FontSize="12"/>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" Margin="2,16,2,0">
                    <TextBlock Text="PRESS ONCE. REPOPAD RUNS THE CHECKED-IN APPLY SCRIPT AS ADMIN."
                               FontFamily="Consolas"
                               FontSize="10"
                               Foreground="#666158"/>
                    <TextBlock Text="v0.1"
                               HorizontalAlignment="Right"
                               FontFamily="Consolas"
                               FontSize="10"
                               Foreground="#837D72"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
