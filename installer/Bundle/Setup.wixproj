<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputName>Chitragupta-Setup</OutputName>
    <OutputType>Bundle</OutputType>
    <CacheDir>$(MSBuildProjectDirectory)\..\..\build\cache</CacheDir>
    <Version Condition="'$(Version)' == ''">0.1.0</Version>
    <DefineConstants>CacheDir=$(CacheDir);Version=$(Version)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.BootstrapperApplications.wixext" Version="5.0.2" />
    <ProjectReference Include="..\Package\Chitragupta.wixproj" />
  </ItemGroup>
</Project>
