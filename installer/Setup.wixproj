<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputName>Chitragupta-Setup</OutputName>
    <OutputType>Bundle</OutputType>
    <CacheDir>$(MSBuildProjectDirectory)\..\build\cache</CacheDir>
    <DefineConstants>CacheDir=$(CacheDir)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.BootstrapperApplications.wixext" Version="5.0.2" />
    <ProjectReference Include="Chitragupta.wixproj" />
  </ItemGroup>
</Project>
